{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Usage Monitor",
  "version": "0.1.0",
  "identifier": "com.aiusagemonitor.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1423",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AI Usage Monitor",
        "width": 250,
        "height": 240,
        "minWidth": 200,
        "minHeight": 150,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "dragDropEnabled": false
      },
      {
        "label": "taskbar-companion",
        "url": "/companion",
        "title": "Claude Usage",
        "width": 190,
        "height": 44,
        "minWidth": 120,
        "minHeight": 24,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "dragDropEnabled": false,
        "focus": false
      },
      {
        "label": "companion-popup",
        "url": "/companion-popup",
        "title": "Claude Usage Detail",
        "width": 248,
        "height": 150,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "focus": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Desktop widget for AI usage limits",
    "longDescription": "Local-first desktop widget for monitoring usage and reset timers across AI providers."
  }
}
